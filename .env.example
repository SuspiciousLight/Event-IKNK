# Local development can use NODE_ENV=development.
# Production must use NODE_ENV=production; backend will fail fast without JWT_SECRET, VK_APP_SECRET, CORS_ORIGIN and CSRF_TRUSTED_ORIGINS.
NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/diplom
CORS_ORIGIN=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

JWT_SECRET=change_me_to_a_long_random_secret
JWT_EXPIRES_IN=12h
JWT_COOKIE_NAME=admin_access_token
ADMIN_COOKIE_SAME_SITE=lax
ADMIN_COOKIE_SECURE=false
VK_APP_SECRET=replace_with_vk_mini_app_secret_for_production
# Local dev may keep this false. In production signature validation is always enforced by NODE_ENV=production.
VK_SIGNATURE_ENFORCED=false
DEV_VK_USER_ID=100001
VK_API_VERSION=5.199
VK_NOTIFICATIONS_ENABLED=false
VK_SERVICE_TOKEN=replace_with_vk_service_token_for_notifications
NOTIFICATION_WORKER_ENABLED=true
NOTIFICATION_WORKER_INTERVAL_MS=60000

ADMIN_LOGIN=admin@example.com
ADMIN_PASSWORD=ChangeMe123!
ADMIN_FULL_NAME=Main Admin

CONSENT_TEXT_VERSION=v1.3-2026-06-09
CONSENT_TEXT_HASH=sha256:210ff306cb02581b79d5e25c60bfe49c7e509ab8ff284bcdbef573de3e819426
