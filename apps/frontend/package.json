{
  "name": "frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "vite --host 0.0.0.0 --port 5173 --strictPort",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0 --port 4173 --strictPort",
    "tunnel:cf": "cloudflared tunnel --url http://localhost:4173",
    "tunnel:cf:dev": "cloudflared tunnel --url http://localhost:5173",
    "tunnel:lt": "npx localtunnel --port 4173",
    "tunnel:lt:dev": "npx localtunnel --port 5173",
    "demo": "npm run build && npm run preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "echo \"No frontend tests yet\"",
    "tunnel:pinggy": "ssh -p 443 -R 0:localhost:4173 a.pinggy.io",
    "tunnel:pinggy:dev": "ssh -p 443 -R 0:localhost:5173 a.pinggy.io"
  },
  "dependencies": {
    "@diplom/shared": "workspace:*",
    "@vkontakte/icons": "^2.120.0",
    "@vkontakte/vk-bridge": "^2.15.11",
    "@vkontakte/vkui": "^7.11.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
